#!/usr/bin/env bash

set -euo pipefail

session=$(tmux display-message -p "#S" 2>/dev/null || echo "")
if [ -z "$session" ]; then
    echo "Could not determine the current session" >&2
    read -r -p "[Enter] to close"
    exit 1
fi

read -r -n1 -p "Kill session '${session}'? [y/N] " ans
echo
if [ "${ans:-}" = "y" ] || [ "${ans:-}" = "Y" ]; then
    tmux kill-session -t "$session"
    echo "Session '${session}' killed"
else
    echo "Cancelled"
fi
sleep 0.6