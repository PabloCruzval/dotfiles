#!/bin/bash
# tmux-workspace — Quick workspace launcher
#
# Each kitty tab runs a separate tmux session.
# Inside the session, windows: zsh → opencode → nvim
#
# Usage:
#   tmux-workspace                    # fzf: sessions + projects
#   tmux-workspace <proyecto>         # type=dev, session=<dir>-dev
#   tmux-workspace <tipo> <proyecto>  # tipo=dev|investigate
#   tmux-workspace add <alias> [ruta] # guardar proyecto
#   tmux-workspace rm <alias>
#   tmux-workspace ls

set -e

CONFIG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-workspace"
CONFIG_FILE="$CONFIG_DIR/projects.json"

# ---------------------------------------------------------------------------
# JSON helpers
# ---------------------------------------------------------------------------
init_config() {
    mkdir -p "$CONFIG_DIR"
    [ -f "$CONFIG_FILE" ] || echo '{"projects":{}}' > "$CONFIG_FILE"
}

get_projects() {
    jq -r '.projects | to_entries[] | "\(.key) \(.value)"' "$CONFIG_FILE" 2>/dev/null
}

get_project_dir() {
    jq -r --arg key "$1" '.projects[$key] // empty' "$CONFIG_FILE" 2>/dev/null
}

set_project() {
    local tmp
    tmp=$(jq --arg key "$1" --arg val "$2" '.projects[$key] = $val' "$CONFIG_FILE")
    echo "$tmp" > "$CONFIG_FILE"
}

del_project() {
    local tmp
    tmp=$(jq "del(.projects[\"$1\"])" "$CONFIG_FILE")
    echo "$tmp" > "$CONFIG_FILE"
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
resolve_dir() {
    local result
    result=$(get_project_dir "$1")
    if [ -n "$result" ]; then
        echo "$result"
        return
    fi
    if [ -d "$1" ]; then
        echo "$(cd "$1" && pwd)"
        return
    fi
    echo ""
}

# ---------------------------------------------------------------------------
# Create or attach session
# ---------------------------------------------------------------------------
open_workspace() {
    local type="$1" dir="$2"
    local name
    name=$(basename "$dir")-$type

    if tmux has-session -t "$name" 2>/dev/null; then
        tmux attach-session -t "$name"
        return
    fi

    cd "$dir"

    if [ "$type" = "dev" ]; then
        tmux new-session -d -s "$name" -n "zsh"
        tmux new-window  -t "$name" -n "opencode"
        tmux new-window  -t "$name" -n "nvim"
        tmux send-keys -t "$name:opencode" "opencode" Enter
        tmux send-keys -t "$name:nvim" "nvim" Enter
        tmux select-window -t "$name:zsh"
    elif [ "$type" = "investigate" ]; then
        tmux new-session -d -s "$name" -n "zsh"
        tmux new-window  -t "$name" -n "opencode"
        tmux send-keys -t "$name:opencode" "opencode" Enter
        tmux select-window -t "$name:zsh"
    fi

    tmux attach-session -t "$name"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_add() {
    local alias="$1"
    local path="${2:-$PWD}"
    path=$(cd "$path" && pwd)
    set_project "$alias" "$path"
    echo "Saved: $alias → $path"
}

cmd_rm() {
    del_project "$1"
    echo "Removed: $1"
}

cmd_ls() {
    get_projects | while IFS=' ' read -r alias path; do
        printf "  %-20s %s\n" "$alias" "$path"
    done
}

# ---------------------------------------------------------------------------
# FZF mode
# ---------------------------------------------------------------------------
fzf_mode() {
    local fzf_input=""
    while IFS=' ' read -r alias path; do
        [ -z "$alias" ] && continue
        fzf_input+="$alias"$'\t'"$path"$'\n'
    done <<< "$(get_projects)"

    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)
    [ -n "$sessions" ] && fzf_input+="---"$'\n'
    for s in $sessions; do
        fzf_input+="$s"$'\t'$'\n'
    done

    selection=$(echo "$fzf_input" | fzf --prompt="tmux > " --height=40% --reverse \
        --with-nth=1 --preview-window=up:3:wrap \
        --preview '
            line={}
            kind=$(echo "$line" | awk -F"\t" "{print \$2}")
            name=$(echo "$line" | awk -F"\t" "{print \$1}")
            if [ -n "$kind" ]; then
                echo "Project: $kind"
            else
                tmux list-windows -t "$name" 2>/dev/null
            fi
        ')

    [ -z "$selection" ] && exit 0

    name=$(echo "$selection" | awk -F"\t" '{print $1}')
    kind=$(echo "$selection" | awk -F"\t" '{print $2}')

    if [ -z "$kind" ]; then
        tmux attach-session -t "$name"
    else
        open_workspace "dev" "$kind"
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
init_config

if [ $# -eq 0 ]; then
    fzf_mode
    exit 0
fi

case "$1" in
    add)  shift; cmd_add "$@" ;;
    rm)   shift; cmd_rm "$@" ;;
    ls)   cmd_ls ;;
    dev|investigate)
        type="$1"
        if [ $# -ge 2 ]; then
            dir=$(resolve_dir "$2")
            [ -z "$dir" ] && echo "Project not found: $2" && exit 1
        else
            dir="$PWD"
        fi
        open_workspace "$type" "$dir"
        ;;
    *)
        dir=$(resolve_dir "$1")
        if [ -n "$dir" ]; then
            open_workspace "dev" "$dir"
        else
            echo "Unknown command or project: $1"
            exit 1
        fi
        ;;
esac
