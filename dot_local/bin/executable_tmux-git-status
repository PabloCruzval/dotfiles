#!/usr/bin/env bash
#
# tmux-git-status - Shows git branch and sync status for tmux status bar
# Only shows GitHub icon if remote exists on github.com
# Only shows sync status if branch has a remote tracking branch

set -e

GIT_ICON=""
BRANCH_ICON=""
IN_SYNC="✓"
AHEAD="↑"
BEHIND="↓"
DIVERGED="⇅"

get_branch() {
    git rev-parse --abbrev-ref HEAD 2>/dev/null
}

has_upstream() {
    git rev-parse --abbrev-ref HEAD@{upstream} &>/dev/null
}

is_github_remote() {
    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null)
    [[ "$remote_url" =~ github\.com ]]
}

get_sync_status() {
    local ahead behind
    ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
    behind=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo 0)

    if [[ "$ahead" -eq 0 && "$behind" -eq 0 ]]; then
        echo "$IN_SYNC"
    elif [[ "$ahead" -gt 0 && "$behind" -eq 0 ]]; then
        echo "${AHEAD}${ahead}"
    elif [[ "$ahead" -eq 0 && "$behind" -gt 0 ]]; then
        echo "${BEHIND}${behind}"
    else
        echo "${DIVERGED}${ahead}${behind}"
    fi
}

main() {
    branch=$(get_branch) || return 0

    if [[ -z "$branch" ]] || [[ "$branch" == "HEAD" ]]; then
        return 0
    fi

    if has_upstream; then
        sync=$(get_sync_status)
        if is_github_remote; then
            printf "%s %s %s" "$GIT_ICON" "$branch" "$sync"
        else
            printf "%s %s %s" "$BRANCH_ICON" "$branch" "$sync"
        fi
    else
        printf "%s %s" "$BRANCH_ICON" "$branch"
    fi
}

main
