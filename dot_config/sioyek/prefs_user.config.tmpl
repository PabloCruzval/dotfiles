# ==============================================================================
# Sioyek Preferences - Catppuccin Macchiato
# ==============================================================================

# Automatically activate custom color theme on startup
startup_commands toggle_custom_color

# --- Document Colors (Custom Color Mode / Dark) ---
custom_background_color                  #24273a
custom_text_color                        #cad3f5

# --- Canvas / Background outside document ---
# In custom color mode (Dark):
custom_color_mode_empty_background_color #24273a
dark_mode_background_color               #24273a
dark_mode_contrast                       0.8

# In light mode (when custom colors are toggled off):
background_color                         0.97 0.97 0.97

# --- Page Separator ---
page_separator_color                     #363a4f
page_separator_width                     2

# --- UI Colors (Command palette, menus) ---
ui_text_color                            #cad3f5
ui_background_color                      #363a4f
ui_selected_text_color                   #cad3f5
ui_selected_background_color             #5b6078

# --- Status Bar ---
status_bar_color                         #363a4f
status_bar_text_color                    #cad3f5
status_bar_font_size                     14

# --- Search, Links & Visual Marks ---
text_highlight_color                     #eed49f
# visual_mark_color requires 4 floats (RGBA) - Catppuccin Overlay1 (#8087a2) with 0.25 alpha
visual_mark_color                        0.50 0.53 0.64 0.25
search_highlight_color                   #eed49f
link_highlight_color                     #8aadf4
synctex_highlight_color                  #a6da95

# --- Highlights Palette (a-g) ---
highlight_color_a                        #eed49f
highlight_color_b                        #a6da95
highlight_color_c                        #91d7e3
highlight_color_d                        #ee99a0
highlight_color_e                        #c6a0f6
highlight_color_f                        #ed8796
highlight_color_g                        #f5a97f

# Ctrl-d / Ctrl-u mueven media pantalla
move_screen_ratio                        0.5
# Modo rectangulo alrededor de la linea en la regla visual
ruler_mode                               1
sort_bookmarks_by_location               1
show_closest_bookmark_in_statusbar       1
show_close_portal_in_statusbar           1
# Indexa el texto para busquedas rapidas y regex_search
super_fast_search                        1
create_table_of_contents_if_not_exists   1

# --- Shared Database Path (synced via sioyek-sync) ---
shared_database_path                     {{ .chezmoi.homeDir }}/.local/share/sioyek/shared.db

# --- External Search & Translation ---
search_url_d                             https://www.deepl.com/translator#auto/es/
search_url_t                             https://translate.google.com/?sl=auto&tl=es&text=

# --- Custom Commands ---
new_command _translate_text {{ .chezmoi.homeDir }}/.local/bin/sioyek-translate "%{selected_text}"
new_command _translate_deepl {{ .chezmoi.homeDir }}/.local/bin/sioyek-translate --deepl "%{selected_text}"
new_command _translate_google {{ .chezmoi.homeDir }}/.local/bin/sioyek-translate --google "%{selected_text}"



