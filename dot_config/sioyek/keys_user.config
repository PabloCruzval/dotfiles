# ==============================================================================
# Sioyek Keybindings
# ==============================================================================

# Toggle custom color theme (Catppuccin) with F8 instead of generic dark mode
toggle_custom_color <f8>

# --- Movimiento ---
move_left        h
move_right       l
screen_down      <C-d>
screen_up        <C-u>

# --- Historial estilo Vimium ---
prev_state       H
next_state       L

# --- Previsualizar referencias sin mouse ---
overview_definition   K
enter_visual_mark_mode gr
keyboard_overview     gf
overview_next_item    <C-n>
overview_prev_item    <C-N>
goto_overview         go
portal_to_overview    gO
close_overview        gq

# --- Portales en una sola pantalla ---
overview_to_portal    gP

# --- Seleccion y Highlights 100% con teclado (sin etiquetas) ---
# 1) Subrayar la linea actual de la regla visual (activala con gr y muevela con j/k):
select_ruler_text;add_highlight                    yh
select_ruler_text;add_highlight_with_current_type  yy
select_ruler_text;copy                             yc
select_ruler_text                                  V

# 2) Ajustar seleccion con teclado (sin etiquetas molestas):
toggle_text_mark                                   v
move_text_mark_forward                             <right>
move_text_mark_backward                            <left>
move_text_mark_forward_word                        <A-l>
move_text_mark_backward_word                       <A-h>
move_text_mark_down                                <down>
move_text_mark_up                                  <up>

# 3) Aplicar / gestionar highlights sobre cualquier seleccion activa:
add_highlight                                      ah
add_highlight_with_current_type                    gy
set_select_highlight_type                          gY
toggle_select_highlight                            gz
delete_highlight                                   dh

# 4) Subrayar la coincidencia activa del buscador (/):
select_current_search_match;add_highlight          ys

# --- Tabla de Contenidos (mover de 't' a 'T' para liberar el prefijo 't' para 'tt') ---
goto_toc                                           T

# --- Traduccion ---
# 1) Popup flotante y portapapeles (sin salir de Sioyek):
_translate_text                                    t
select_ruler_text;_translate_text                  yt

# 2) Abrir traduccion en navegador:
_translate_deepl                                   gd
select_ruler_text;_translate_deepl                 yd
_translate_google                                  gt
select_ruler_text;_translate_google                yT



# q deja de cerrar Sioyek y pasa a cerrar overview y regla
close_overview;close_visual_mark q

# cerrar Sioyek ahora requiere ZZ, como guardar y salir en vim
quit ZZ

