# ~/.config/sioyek-sync/config.env
# Configuración centralizada para sioyek-sync

# Ruta local de shared.db (debe coincidir con shared_database_path en prefs_user.config)
LOCAL_DB="${HOME}/.local/share/sioyek/shared.db"

# Base de datos en Cloudflare R2 (bucket 'nyx', subcarpeta 'sioyek')
DB_RCLONE_REMOTE="Cloudflare"
DB_REMOTE_BUCKET="nyx"
DB_REMOTE_DIR="sioyek"
DB_REMOTE_NAME="shared.db"

# Sincronización bidireccional de carpeta de PDFs en Google Drive (1 = habilitado, 0 = deshabilitado)
SYNC_PDFS=1
# Sincronizar PDFs en segundo plano al cerrar Sioyek para cierre instantáneo (1 = asíncrono/segundo plano, 0 = sincrónico)
ASYNC_PDF_SYNC=1
PDF_RCLONE_REMOTE="Sioyek"
LOCAL_PDF_DIR="${HOME}/Documents/GPdf"
REMOTE_PDF_DIR="GPdf"
REMOTE_PDF_TRASH_DIR="sioyek/pdf-trash"

# Directorios locales de estado y logs
STATE_DIR="${HOME}/.local/state/sioyek-sync"
LOG_DIR="${HOME}/.local/state/sioyek-sync"

# Locks en tmpfs (por usuario)
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp/sioyek-sync-${UID}}"
SESSION_LOCK="${LOCK_DIR}/session.lock"
TRANSFER_LOCK="${LOCK_DIR}/transfer.lock"
PDF_LOCK="${LOCK_DIR}/pdf-sync.lock"

# Binario real de Sioyek y plataforma Qt (xcb evita fallo EGL 3009 en Wayland/NVIDIA)
SIOYEK_BIN="/usr/bin/sioyek"
SIOYEK_QT_QPA_PLATFORM="xcb"

# Retención de versiones anteriores (3 copias remotas ~110KB + base activa ~36KB = ~146KB total)
REMOTE_BACKUP_KEEP=3
LOCAL_BACKUP_KEEP=5

# Timeouts
SQLITE_TIMEOUT_MS=5000
RCLONE_CONTIMEOUT="5s"
RCLONE_TIMEOUT="20s"
RCLONE_RETRIES=1

# Mostrar ventana flotante de progreso al sincronizar (1 = sí, 0 = no)
SHOW_SYNC_WINDOW=1

# Modo simulación global (0 = real, 1 = dry-run; también activable con --dry-run)
DRY_RUN=0
