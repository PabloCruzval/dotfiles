# ==============================================================================
# Zathura Configuration — Catppuccin Macchiato
# ==============================================================================

# Comportamiento general
set selection-clipboard         "clipboard"
set adjust-open                 "width"
set pages-per-row               1
set scroll-step                 60
set font                        "JetBrainsMono Nerd Font 10"

# Ocultar barras innecesarias
set guioptions                  "s"
set statusbar-home-tilde        "true"

# Colores de interfaz (Catppuccin Macchiato)
set default-fg                  "rgba(202,211,245,1)"
set default-bg                  "rgba(36,39,58,1)"

set completion-bg               "rgba(54,58,79,1)"
set completion-fg               "rgba(202,211,245,1)"
set completion-highlight-bg     "rgba(198,160,246,1)"
set completion-highlight-fg     "rgba(36,39,58,1)"
set completion-group-bg         "rgba(30,32,48,1)"
set completion-group-fg         "rgba(202,211,245,1)"

set statusbar-fg                "rgba(202,211,245,1)"
set statusbar-bg                "rgba(24,25,38,1)"
set inputbar-fg                 "rgba(202,211,245,1)"
set inputbar-bg                 "rgba(36,39,58,1)"

set notification-bg             "rgba(36,39,58,1)"
set notification-fg             "rgba(202,211,245,1)"
set notification-error-bg       "rgba(36,39,58,1)"
set notification-error-fg       "rgba(237,135,150,1)"
set notification-warning-bg     "rgba(36,39,58,1)"
set notification-warning-fg     "rgba(238,212,159,1)"

# Modo oscuro para páginas de documentos
set recolor                     "true"
set recolor-keephue             "true"
set recolor-lightcolor          "rgba(36,39,58,1)"
set recolor-darkcolor           "rgba(202,211,245,1)"

set index-fg                    "rgba(202,211,245,1)"
set index-bg                    "rgba(36,39,58,1)"
set index-active-fg             "rgba(202,211,245,1)"
set index-active-bg             "rgba(54,58,79,1)"

set render-loading-bg           "rgba(36,39,58,1)"
set render-loading-fg           "rgba(202,211,245,1)"

set highlight-color             "rgba(147,154,183,0.3)"
set highlight-fg                "rgba(202,211,245,1)"
set highlight-active-color      "rgba(198,160,246,0.3)"

# Modo visual (zathura-git)
set visual-caret-color          "rgba(245,189,239,1)"

# Mapeos de teclado
map r recolor
map [normal] u scroll half-up
map [normal] d scroll half-down
map [normal] D toggle_page_mode
map [normal] F toggle_fullscreen
map [normal] <C-m> toggle_statusbar

# Traducción con YAD flotante + translate-shell (tras yank 'y' o selección de ratón)
map t exec "sh -c 'text=$(wl-paste -t text/plain 2>/dev/null || wl-paste -p -t text/plain 2>/dev/null); if [ -n \"$text\" ]; then cleaned=$(printf \"%s\" \"$text\" | sed -E \":a;N;\\$!ba;s/([a-zA-Z]+)-\\n[ \\t]*([a-zA-Z]+)/\\1\\2/g; s/([^\\n])\\n([^\\n])/\\1 \\2/g\"); trans -b :es \"$cleaned\" | yad --text-info --title=\"Traducción\" --width=540 --height=160 --undecorated --no-buttons --close-on-unfocus --wrap --mouse --back=\"#24273a\" --fore=\"#cad3f5\" --borders=12; fi'"
map gd exec "sh -c 'text=$(wl-paste -t text/plain 2>/dev/null || wl-paste -p -t text/plain 2>/dev/null); cleaned=$(printf \"%s\" \"$text\" | sed -E \":a;N;\\$!ba;s/([a-zA-Z]+)-\\n[ \\t]*([a-zA-Z]+)/\\1\\2/g; s/([^\\n])\\n([^\\n])/\\1 \\2/g\"); xdg-open \"https://www.deepl.com/translator#auto/es/$(printf \"%s\" \"$cleaned\" | jq -sRr @uri)\"'"
map gt exec "sh -c 'text=$(wl-paste -t text/plain 2>/dev/null || wl-paste -p -t text/plain 2>/dev/null); cleaned=$(printf \"%s\" \"$text\" | sed -E \":a;N;\\$!ba;s/([a-zA-Z]+)-\\n[ \\t]*([a-zA-Z]+)/\\1\\2/g; s/([^\\n])\\n([^\\n])/\\1 \\2/g\"); xdg-open \"https://translate.google.com/?sl=auto&tl=es&text=$(printf \"%s\" \"$cleaned\" | jq -sRr @uri)\"'"
